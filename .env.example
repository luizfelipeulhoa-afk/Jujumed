# Copie para .dev.vars ou .env.local. Não commite chaves reais.
# No Cloudflare: Workers → jujumed → Settings → Variables and Secrets → Secret.
# Sem prefixo VITE_: estas chaves não podem ir para o navegador.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# Supabase (público no build, privado no Worker)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Correção discursiva, endpoint compatível com a API de chat da OpenAI
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
